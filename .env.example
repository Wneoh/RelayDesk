# Copy to .env at the repository root. These are local development values.
DATABASE_URL=postgres://relaydesk:relaydesk@localhost:5432/relaydesk
PORT=3001
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set a long random secret before deploying; development has a local-only default.
SESSION_SECRET=change-this-to-at-least-32-random-characters
# Defaults to false. Enable only for a disposable public demo.
DEMO_MODE=false

# AI_MODE: live, demo (scripted local examples), or unavailable.
# npm run demo uses the labelled scripted mode when no key is present.
AI_MODE=unavailable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set HOST=0.0.0.0 when deploying behind your own reverse proxy/container.
HOST=127.0.0.1
